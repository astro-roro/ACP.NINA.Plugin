<ResourceDictionary
    x:Class="ACP.NINA.Plugin.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="Astro Coverage Planner (ACP)_Options">
        <StackPanel Margin="0,10,0,10" Orientation="Vertical">

            <TextBlock FontSize="14" FontWeight="Bold" Text="Connection" Margin="0,0,0,6" />

            <Grid Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Server URL:"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         Margin="6,0,6,0"
                         Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         Height="24"
                         ToolTip="The HTTP URL of a running ACP instance. Defaults to http://127.0.0.1:5555 (loopback)." />
                <Button Grid.Row="0" Grid.Column="2"
                        Content="Test"
                        Width="60" Height="24"
                        Command="{Binding TestConnectionCommand}" />

                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                           Margin="6,4,0,0"
                           FontSize="11"
                           Opacity="0.75"
                           TextWrapping="Wrap"
                           Text="{Binding ConnectionTestResult}" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="API token:"
                           VerticalAlignment="Center" />
                <!-- NINA styles TextBox but not PasswordBox, which otherwise
                     renders in stock WPF white. Give it the text box's tint,
                     border and foreground so it matches the URL field. -->
                <PasswordBox Grid.Row="2" Grid.Column="1"
                             x:Name="TokenBox"
                             Margin="6,6,6,0"
                             Height="24"
                             VerticalContentAlignment="Center"
                             Foreground="{StaticResource PrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="0,0,0,1"
                             CaretBrush="{StaticResource PrimaryBrush}"
                             PasswordChanged="TokenBox_PasswordChanged"
                             ToolTip="The value of ACP_API_TOKEN on the ACP server. Stored in Windows Credential Manager, never in the plugin's settings file. Leave blank if ACP runs on this machine with no token set.">
                    <PasswordBox.Background>
                        <SolidColorBrush Opacity="0.05" Color="{Binding Color, Source={StaticResource PrimaryBrush}}" />
                    </PasswordBox.Background>
                </PasswordBox>
                <Button Grid.Row="2" Grid.Column="2"
                        Margin="0,6,0,0"
                        Content="Clear"
                        Width="60" Height="24"
                        Command="{Binding ClearTokenCommand}"
                        ToolTip="Remove the stored token from Windows Credential Manager." />

                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                           Margin="6,4,0,0"
                           FontSize="11"
                           Opacity="0.75"
                           TextWrapping="Wrap"
                           Text="{Binding TokenStatus}" />

                <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                           Margin="6,8,0,0"
                           FontSize="11"
                           Opacity="0.7"
                           TextWrapping="Wrap"
                           Text="ACP can run on another machine reachable over your LAN or a VPN such as Tailscale. Set a token on both sides when it does. Do not port forward ACP to the Internet." />
            </Grid>

            <TextBlock FontSize="14" FontWeight="Bold" Text="Plan matching" Margin="0,0,0,6" />

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Which plans to load into Target Scheduler:"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                          Margin="6,0,0,0"
                          Height="24"
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding SyncModeOptions}"
                          SelectedItem="{Binding SelectedSyncModeOption}"
                          ToolTip="Everything loads every plan in ACP. Only what fits tonight loads the plans that match the gear the plate solve says is actually connected." />
            </Grid>

            <TextBlock Margin="0,0,0,12"
                       FontSize="11"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Text="{Binding SyncModeExplanation}" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding ProfileWriteBackEnabled}"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="Update the profile focal length from the plate solve (Sync for tonight only, when it is more than 5 percent out)" />
            </Grid>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding ReportProgressToAcp}"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="Report progress to ACP while imaging" />
            </Grid>

            <TextBlock FontSize="11"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Text="{Binding ReportProgressExplanation}" />

            <TextBlock FontSize="14" FontWeight="Bold" Text="Behavior" Margin="0,0,0,6" />

            <!-- NINA's CheckBox style renders as a toggle and hides the Content
                 property, so labels live in side-by-side TextBlocks rather than
                 inside the CheckBox. Mirrors NINA core's own options pattern. -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding AutoRefreshEnabled}"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center">
                    <Run Text="Auto-refresh plans every " /><Run Text="{Binding AutoRefreshSeconds}" /><Run Text=" seconds" />
                </TextBlock>
            </Grid>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding ConfirmBeforeTsSync}"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="Confirm before Sync to TS" />
            </Grid>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Height="24"
                         Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding SolveAttempts}"
                         ToolTip="Frames a Sync for tonight solve takes before giving up, 1 to 20. NINA's own plate solve setting is left alone for centring." />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="Solve attempts for Sync for tonight" />
            </Grid>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Height="24"
                         Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding ActionTimeoutMinutes}"
                         ToolTip="The longest any ACP action may run before it stops on its own: the dock buttons and the sequence instruction. 0 means no limit." />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="Time limit for ACP actions, minutes (0 for none)" />
            </Grid>

            <TextBlock FontSize="14" FontWeight="Bold" Text="Binning" Margin="0,12,0,6" />

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Height="24"
                         Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding ImagingBinning}"
                         ToolTip="The bin factor you image at, 1 to 8. Plans are judged against the pixel scale at this binning." />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="Imaging binning" />
            </Grid>

            <TextBlock Margin="0,0,0,12"
                       FontSize="11"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Text="The binning plans are judged against. The camera's current binning is never used, so a test frame at another bin does not change the verdict." />

            <TextBlock FontSize="14" FontWeight="Bold" Text="Focal length solve frame" Margin="0,0,0,6" />

            <TextBlock Margin="0,0,0,6"
                       FontSize="11"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Text="The frame Sync for tonight takes to measure focal length. Leave a box empty to use NINA's plate solve setting (exposure, filter, binning) or the camera's default (gain, offset). A Sync for tonight instruction with an exposure above 0 still uses its own exposure." />

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Height="24"
                         Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding SolveExposureText}"
                         ToolTip="Exposure in seconds. Empty uses the plate solve setting." />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="Exposure, seconds" />
            </Grid>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Height="24"
                         Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding SolveBinningText}"
                         ToolTip="Bin factor of the solve frame, 1 to 8. Empty uses the plate solve setting." />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="Solve binning" />
            </Grid>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Text="Filter" />
                <ComboBox Grid.Column="1"
                          Height="24"
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding SolveFilterOptions}"
                          SelectedItem="{Binding SelectedSolveFilterOption}"
                          ToolTip="The filter for the solve frame, from the active profile's filter wheel. The first choice uses the plate solve setting." />
            </Grid>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Height="24"
                         Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding SolveGainText}"
                         ToolTip="Camera gain for the solve frame. Empty leaves the camera at its default." />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="Gain" />
            </Grid>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Height="24"
                         Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding SolveOffsetText}"
                         ToolTip="Camera offset for the solve frame. Empty leaves the camera at its default." />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="Offset" />
            </Grid>

        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
