<ResourceDictionary
    x:Class="ACP.NINA.Plugin.Sequencer.SyncForTonightTemplate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ACP.NINA.Plugin.Sequencer">

    <DataTemplate x:Key="ACP.NINA.Plugin.Sequencer.SyncForTonight_Mini">
        <StackPanel Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="ACP: Sync for tonight" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:SyncForTonight}">
        <StackPanel Orientation="Vertical" Margin="0,4,0,4">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock VerticalAlignment="Center" Text="Exposure" />
                <TextBox Width="60" Height="24" Margin="6,0,0,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding ExposureTime, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Seconds for the frame this instruction solves. Long enough to get stars, short enough not to waste the start of the night." />
                <TextBlock VerticalAlignment="Center" Margin="4,0,0,0" Text="s" />
            </StackPanel>

            <!-- NINA's CheckBox style renders as a toggle and hides Content, so
                 the labels sit in TextBlocks beside it. Same pattern as the
                 options page and as NINA core's own instructions. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding SlewFirst}" />
                <TextBlock VerticalAlignment="Center" Margin="8,0,0,0"
                           Text="Slew to these coordinates first" />
            </StackPanel>

            <ContentPresenter Margin="0,0,0,4"
                              Content="{Binding Coordinates}"
                              Visibility="{Binding SlewFirst, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />

            <StackPanel Orientation="Horizontal">
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding UpdateProfileFocalLength}" />
                <TextBlock VerticalAlignment="Center" Margin="8,0,0,0"
                           TextWrapping="Wrap"
                           Text="Update the profile focal length and focal ratio when the solve says they are more than 5 percent out" />
            </StackPanel>

        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
