<ResourceDictionary
    x:Class="ACP.NINA.Plugin.Dockables.AcpDockableTemplate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ACP.NINA.Plugin.Dockables">

    <DataTemplate DataType="{x:Type local:AcpDockableVM}">
        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: connection status -->
            <Border Grid.Row="0"
                    Padding="6,4"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#888" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="#4CAF50" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                            <Setter Property="Fill" Value="#F44336" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="24" Height="24"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Refresh plans from ACP"
                            Content="⟳" />
                </Grid>
            </Border>

            <!-- Row 1: plans header -->
            <TextBlock Grid.Row="1"
                       Margin="0,8,0,4"
                       FontWeight="Bold">
                <Run Text="Plans (" /><Run Text="{Binding Plans.Count, Mode=OneWay}" /><Run Text=")" />
            </TextBlock>

            <!-- Row 2: plans list -->
            <Border Grid.Row="2"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <ListBox ItemsSource="{Binding Plans}"
                         SelectedItem="{Binding SelectedPlan}"
                         HorizontalContentAlignment="Stretch"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,6,4,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding ProjectName}"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding State}"
                                           FontSize="11"
                                           Opacity="0.7" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Margin="8,2,0,0"
                                           FontSize="11"
                                           Opacity="0.85">
                                    <Run Text="{Binding TargetName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding FilterSummary, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                           Margin="8,2,0,0"
                                           FontSize="11"
                                           Opacity="0.65">
                                    <Run Text="{Binding MosaicShort, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding GearShort, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Row 3: selected plan details -->
            <Border Grid.Row="3"
                    Margin="0,8,0,0"
                    Padding="6,4"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Binding SelectedPlanSummary}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedPlanCoordinates}"
                               FontSize="11"
                               Opacity="0.85"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Row 4: action buttons, a 2x2 grid of equal width so nothing
                 is ever squeezed at a narrow dock width. Compact (24px,
                 small padding and text) so the plan list above keeps most
                 of the dock's height. Sync for tonight and Sync All to TS
                 lead, since they are the everyday actions; Push to Framing
                 and Send TS to ACP follow. -->
            <StackPanel Grid.Row="4"
                        Margin="0,8,0,0"
                        Orientation="Vertical">
                <UniformGrid Rows="2" Columns="2">
                    <Button Height="24"
                            Margin="0,0,3,3"
                            Padding="4,0"
                            FontSize="11"
                            Command="{Binding SyncForTonightCommand}"
                            Content="Sync for tonight"
                            ToolTip="Solves a frame from where the mount is pointing, works out the connected gear from it, and asks ACP which plans fit tonight. Updates the profile focal length and focal ratio when the solve says they are more than 5 percent out. Reuses a solve from the last hour rather than taking another one." />
                    <Button Height="24"
                            Margin="3,0,0,3"
                            Padding="4,0"
                            FontSize="11"
                            Command="{Binding SyncAllToTsCommand}"
                            Content="Sync All to TS" />
                    <Button Height="24"
                            Margin="0,3,3,0"
                            Padding="4,0"
                            FontSize="11"
                            Command="{Binding PushToFramingCommand}"
                            Content="Push to Framing" />
                    <Button Height="24"
                            Margin="3,3,0,0"
                            Padding="4,0"
                            FontSize="11"
                            Command="{Binding SendTsToAcpCommand}"
                            Content="Send TS to ACP"
                            ToolTip="Sends a read-only copy of Target Scheduler's database to ACP. ACP shows what would change before anything does. Nothing in TS changes." />
                </UniformGrid>
                <TextBlock Margin="0,6,0,0"
                           FontSize="11"
                           Opacity="0.7">
                    <Run Text="Will sync to profile: &quot;" /><Run Text="{Binding ActiveProfileName, Mode=OneWay}" /><Run Text="&quot;" />
                </TextBlock>
            </StackPanel>

            <!-- Row 5: last action result, with Review and apply in ACP
                 beside it as a small link-style button once an upload has
                 a review page to open. The text column is star-width so
                 the button never clips it; the result wraps under the
                 button at a narrow width instead. The button is named as
                 an action (Review AND apply), because a plain "Open" gave
                 no sense that anything was waiting to be looked at. -->
            <Grid Grid.Row="5" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           FontSize="11"
                           Opacity="0.85"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Text="{Binding LastActionResult}" />
                <Button Grid.Column="1"
                        Margin="6,0,0,0"
                        Padding="6,2"
                        FontSize="11"
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalAlignment="Top"
                        Command="{Binding OpenReviewCommand}"
                        Content="Review and apply in ACP"
                        ToolTip="Opens ACP's review page for this upload in your browser, where you choose what to apply. Nothing changes until you press Apply there."
                        Visibility="{Binding HasReviewUrl, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
            </Grid>

            <!-- Row 6: progress reporting footer (Part F) -->
            <TextBlock Grid.Row="6"
                       Margin="0,4,0,0"
                       FontSize="11"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Text="{Binding ProgressStatusLine}" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>
